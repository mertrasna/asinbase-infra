  "semantics": {
    "heartbeat": "Completed iteration only; scheduled workers emit after their actual scheduled pass, never from a liveness timer. Missing data alarms require explicitly expected workers and their bounded cadence.",
    "ages": "Original enqueue time; retries and future available_at do not reset backlog age. Empty available queues report zero; unavailable capability emits CapabilityUnavailable only.",
    "email": "Transport attempts/SMTP acceptance are distinct from shared rolling mailbox budget and observed recipient delivery. Supabase Auth and other mailbox senders are outside this process.",
    "recommendations": "Private counts only; no recommendation email channel. Publication and policy/cost/cadence remain R6-owned.",
    "clock": "Database aggregates use one statement clock; future timestamps clamp age to zero.",
    "counters": "Counter metrics describe events; gauges describe the sampled aggregate state. Do not sum overlapping gauges.",
    "cache_instances": "When telemetry is enabled, at most eight growth workers are allowed; each has its own fixed component and heartbeat. A healthy shard cannot mask a stalled shard."
  }
